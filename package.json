{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,backend,anime -c green,cyan,magenta \"next dev\" \"npm run backend\" \"npm run anime:all\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "backend": "cd aPi-embeds-m3u8s/core && npm run dev",
    "anime:anivexa": "cd Anivexa-API && node server.js",
    "anime:aniwatch": "cd Aniwatch-Api-main/src && node inde.js",
    "anime:hianime": "cd hianime-api-v2 && npx tsx index.ts",
    "anime:all": "concurrently -n anivexa,aniwatch,hianime -c yellow,blue,magenta \"npm run anime:anivexa\" \"npm run anime:aniwatch\" \"npm run anime:hianime\"",
    "anime-api": "npm run anime:all"
  },
  "dependencies": {
    "@consumet/extensions": "^1.8.8",
    "@omss/framework": "^1.1.26",
    "@use-gesture/react": "^10.3.1",
    "@videojs/hlsjs-video": "^10.0.0-rc.2",
    "@videojs/react": "^10.0.0-rc.2",
    "@videojs/shaka-video": "^10.0.0-rc.2",
    "@vidstack/react": "^1.15.6",
    "artplayer": "^5.4.0",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "firebase": "^12.18.0",
    "framer-motion": "^13.2.0",
    "got-scraping": "^4.2.1",
    "gsap": "^3.15.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.49.0",
    "next": "16.3.4",
    "next-pwa": "^5.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shaka-player": "^5.2.9",
    "strataplayer": "^1.2.23"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
