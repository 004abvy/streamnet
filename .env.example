# Backend URL (Optional - leave empty on Vercel because the API runs natively on the same domain!)
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_TMDB_IMAGE_URL=https://image.tmdb.org/t/p/w500

# TMDB API Configuration (Used by serverless API routes on Vercel)
TMDB_API_KEY=your_tmdb_api_key
TMDB_READ_TOKEN=your_tmdb_read_token_optional

# Firebase Auth Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
